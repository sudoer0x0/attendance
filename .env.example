# ==============================================================================
# ATTEND — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env or .env.local for local development.
# In production (e.g. Vercel), add these keys to your project settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Connection pooling URL (used by application runtime)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL (used for Prisma schema migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. REDIS (Upstash — Distributed state for QR tokens & rate limiting)
# ------------------------------------------------------------------------------
# Create a free Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_rest_token_here"

# ------------------------------------------------------------------------------
# 3. JWT ENCRYPTION SECRETS (Generate with: openssl rand -base64 32)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="your_random_32_byte_access_secret_here"
JWT_REFRESH_SECRET="your_random_32_byte_refresh_secret_here"
JWT_ACCESS_TTL_MIN="15"
JWT_REFRESH_TTL_DAYS="14"

# ------------------------------------------------------------------------------
# 4. SECRET PORTAL PATHS (Obscure high-privilege routes from scrapers)
# ------------------------------------------------------------------------------
# Custom URL slugs for each administrative portal
SUPER_ADMIN_SECRET_PATH="your_secret_superadmin_path_slug"
DEPT_ADMIN_SECRET_PATH="your_secret_dept_admin_path_slug"
STAFF_SECRET_PATH="your_secret_staff_path_slug"

# ------------------------------------------------------------------------------
# 5. CRON CLEANUP SECRET (For 30-day recycle bin purge endpoint)
# ------------------------------------------------------------------------------
# Required Bearer token to trigger POST /api/cron/purge-deleted-students
CRON_SECRET="your_random_cron_secret_here"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAILS (Optional - Resend)
# ------------------------------------------------------------------------------
# If omitted, temporary passwords are shown directly on-screen in admin modals.
RESEND_API_KEY="re_your_resend_api_key_here"
ALERT_EMAIL_FROM="Attend Security <security@your-domain.com>"

# ------------------------------------------------------------------------------
# 7. DOMAIN & APP ORIGIN CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://your-domain.com"
WEBAUTHN_RP_ID="your-domain.com"
WEBAUTHN_RP_NAME="Attend"
WEBAUTHN_ORIGIN="https://your-domain.com"

# ------------------------------------------------------------------------------
# 8. CLOUDFLARE ZERO TRUST / ACCESS (Optional)
# ------------------------------------------------------------------------------
# CLOUDFLARE_ACCESS_AUD="your_cloudflare_access_audience_tag"
# CF_ACCESS_TEAM_NAME="your_team_name"
